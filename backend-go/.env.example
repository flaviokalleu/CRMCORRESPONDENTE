# ===== Servidor =====
NODE_ENV=development
PORT=8001

# ===== Banco (MESMO Postgres do backend Node — strangler-fig) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crmjs
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=disable
DB_TIMEZONE=America/Sao_Paulo

# ===== JWT (obrigatório — o boot falha sem JWT_SECRET_KEY) =====
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# ===== CORS =====
FRONTEND_URL=http://localhost:3000,http://localhost:3003
