# ===== Servidor =====
NODE_ENV=development
PORT=8001

# ===== Banco (MESMO Postgres do backend Node — strangler-fig) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crmjs
DB_USERNAME=postgres
DB_PASSWORD=99480231a
DB_SSLMODE=disable
DB_TIMEZONE=America/Sao_Paulo

# ===== JWT (obrigatório — o boot falha sem JWT_SECRET_KEY) =====
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# ===== CORS =====
FRONTEND_URL=http://localhost:3000,http://localhost:3003

# E-mail (SMTP) — usado pela recuperação de senha e pelos avisos de pagamento.
# Sem SMTP_USER/SMTP_PASSWORD o envio é simulado e nenhum e-mail sai.
# O link de "Esqueci a senha" aponta para a PRIMEIRA URL de FRONTEND_URL.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Webba CRM
