# Variáveis do docker-compose. Copie para `.env` e preencha antes do primeiro
# `docker compose up -d`. O arquivo `.env` não é versionado.

# ===== Domínio e TLS =====
# Aponte o DNS do domínio para o IP da VPS ANTES de subir: o Caddy só consegue
# emitir o certificado se o Let's Encrypt alcançar o domínio na porta 80.
DOMINIO=crm.seudominio.com.br
EMAIL_TLS=voce@seudominio.com.br

# ===== Banco =====
DB_NAME=crmjs
DB_USERNAME=crm
# Gere com: openssl rand -base64 24
DB_PASSWORD=

# ===== JWT — o boot da API falha sem estas duas =====
# Gere cada uma com: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# ===== MinIO (storage dos documentos) =====
# Estas credenciais são o usuário root do MinIO; trate como senha de banco.
# Gere com: openssl rand -hex 16
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=crm-uploads

# ===== Marca =====
NOME_SISTEMA=Webba CRM
